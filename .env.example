# Preferred (new) names — OR keep legacy DB_* / PORT (also supported)

API_HOST=0.0.0.0
# API_PORT=3003
PORT=3003
NODE_ENV=production
PUBLIC_BASE_PATH=/

# CMS images MUST be written into the IIS website uploads folder so
# https://app.shantigyanniketan.org/uploads/… works as a normal static URL.
#
# On Windows IIS box (if API runs there):
# UPLOADS_DIR=C:\inetpub\wwwroot\app.shantigyanniketan.org\uploads
#
# On Ubuntu (API host): mount that IIS folder, then:
# UPLOADS_DIR=/mnt/sgn-iis-uploads
UPLOADS_DIR=/mnt/sgn-iis-uploads

# MSSQL (preferred)
# MSSQL_SERVER=172.31.11.96
# MSSQL_DATABASE=sgncms
# MSSQL_USER=sa
# MSSQL_PASSWORD='YourPassword'
# MSSQL_PORT=1433
# MSSQL_ENCRYPT=false
# MSSQL_TRUST_SERVER_CERTIFICATE=true

DB_SERVER=172.31.11.96
DB_PORT=1433
DB_NAME=sgncms
DB_USER=sa
DB_PASSWORD='YourPassword'
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

API_BODY_LIMIT=100mb

CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=sgn@cms2026
