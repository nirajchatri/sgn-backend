# Express API
API_PORT=3001
API_HOST=0.0.0.0

# When the public site is under https://example.com/neu/
PUBLIC_BASE_PATH=/neu

# Optional: same value the frontend sends as X-CMS-Key (defaults to CMS user:pass)
# CMS_API_KEY=admin:sgn@cms2026

# MSSQL — use discrete fields OR a full connection string
# MSSQL_CONNECTION_STRING=Server=172.31.11.96,1433;Database=sgncms;User Id=sa;Password=YourPassword;Encrypt=true;TrustServerCertificate=true;

MSSQL_SERVER=172.31.11.96
MSSQL_DATABASE=sgncms
MSSQL_USER=sa
# Use single quotes if the password contains $ or #
MSSQL_PASSWORD='YourPassword'
MSSQL_PORT=1433
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Optional timeouts (ms)
# MSSQL_CONNECTION_TIMEOUT_MS=15000
# MSSQL_REQUEST_TIMEOUT_MS=30000

# Uploads: leave unset for ./uploads next to this project.
# On Windows IIS static serving, point at the neu\uploads folder:
# UPLOADS_DIR=C:\inetpub\wwwroot\shantigyanniketan.org\neu\uploads
