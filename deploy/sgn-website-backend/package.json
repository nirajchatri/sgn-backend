{
  "name": "sgn-website-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SGN website CMS API (Express + MSSQL). Deploy this project to Ubuntu.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "start:api": "tsx server/index.ts",
    "check:mssql": "node scripts/check-mssql.mjs",
    "pack": "node scripts/pack-ubuntu.mjs",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "mssql": "^12.7.2",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "typescript": "^5.9.2"
  }
}
